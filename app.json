{
  "expo": {
    "name": "flood-relief",
    "slug": "flood-relief",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "floodrelief",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/boat3.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "statusBar": {
        "backgroundColor": "#2563EB",
        "barStyle": "light-content"
      },
      "navigationBar": {
        "backgroundColor": "#2563EB",
        "barStyle": "light-content"
      }
    },
    "plugins": ["expo-router"]
  }
}