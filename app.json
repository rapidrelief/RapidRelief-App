{
  "expo": {
    "name": "flood-relief",
    "slug": "flood-relief",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "floodrelief",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "android": {
      "edgeToEdgeEnabled": false,

      "statusBar": {
        "backgroundColor": "#F8FAFC",
        "barStyle": "dark-content"
      },

      "navigationBar": {
        "backgroundColor": "#F8FAFC",
        "barStyle": "dark-content"
      }
    },

    "plugins": ["expo-router"]
  }
}
